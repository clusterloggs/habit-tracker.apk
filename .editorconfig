[android]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_size = 4
indent_style = space
max_line_length = 120
trim_trailing_whitespace = true

[{*.kt,*.kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_code_style_defaults = KOTLIN_STYLE_GUIDE
indent_size = 4
insert_final_newline = true
max_line_length = 120

[*.gradle.kts]
indent_size = 4

[*.md]
indent_size = 2
max_line_length = off
